[
 {
  "name": "python",
  "exe": "uv",
  "args": [
   "python",
   "install",
   "3.12"
  ],
  "timeout_min": 15,
  "stop_on_fail": true
 },
 {
  "name": "venv-ovg",
  "exe": "uv",
  "args": [
   "venv",
   "{ROOT}\\.venv-ovg",
   "--python",
   "3.12",
   "--python-preference",
   "only-managed",
   "--allow-existing"
  ],
  "timeout_min": 10
 },
 {
  "name": "pip-ovg",
  "exe": "uv",
  "args": [
   "pip",
   "install",
   "--python",
   "{ROOT}\\.venv-ovg\\Scripts\\python.exe",
   "-r",
   "{ROOT}\\pc\\req\\ovg.txt"
  ],
  "timeout_min": 45
 },
 {
  "name": "versions-ovg",
  "exe": "py",
